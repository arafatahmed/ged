# Copier en .env puis remplacer toutes les valeurs « a-changer ».
# Ne jamais versionner le fichier .env.

# Django
GED_SECRET_KEY=a-changer-50-caracteres-aleatoires-minimum
GED_ALLOWED_HOSTS=ged.institution.example
GED_CSRF_TRUSTED_ORIGINS=https://ged.institution.example
GED_ADMIN_URL=administration-technique/
GED_TIME_ZONE=UTC
GED_SESSION_DUREE_SECONDES=28800
GED_GUNICORN_WORKERS=3
GED_LOG_LEVEL=INFO
# Mode multi-institutions (false : une installation = une institution)
GED_MULTI_INSTITUTIONS=false

# PostgreSQL
POSTGRES_PASSWORD=a-changer
GED_DB_NAME=ged
# Propriétaire du schéma : migrations uniquement
GED_DB_OWNER_USER=ged_proprietaire
GED_DB_OWNER_PASSWORD=a-changer
# Rôle de l'application : données uniquement, journal d'audit en ajout seul
GED_DB_USER=ged_app
GED_DB_PASSWORD=a-changer

# Stockage objet compatible S3 (buckets privés), servi par SeaweedFS dans compose.yaml.
# Lettres, chiffres, « - » et « _ » uniquement.
GED_S3_ACCESS_KEY=a-changer
GED_S3_SECRET_KEY=a-changer-au-moins-8-caracteres
GED_S3_BUCKET=ged
GED_S3_REGION=us-east-1

# Ports publiés par Nginx
GED_PORT_HTTP=80
GED_PORT_HTTPS=443
